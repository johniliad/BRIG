.env
.env.*
!.env.example
private-config/
# Cloudflare origin-lock secret rendered into dist/.htaccess at build time.
# NEVER commit the value; the repo only stores the placeholder in .htaccess.
private-config/cf-origin-secret.txt
# Local private config with real secrets (never commit)
/brig.php
# Logs
*.log
npm-debug.log*
