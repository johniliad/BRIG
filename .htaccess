# BRIG — Apache configuration (cPanel). Place this in the web root.
#
# ===========================================================================
#  TEMPLATE — DO NOT UPLOAD THIS FILE.
#
#  `npm run build` renders it to dist/.htaccess with the real Cloudflare
#  origin secret (scripts/render-htaccess.mjs, docs/deployment.md section 15).
#  Upload dist/.htaccess instead. Uploading this file as-is makes every
#  request return 403, because the placeholder below never matches.
# ===========================================================================
Options -Indexes

# ---------------------------------------------------------------------------
# Branded error documents (generated into dist/ from public/403.html,
# 404.html and 500.html). They use the site's own look and feel and are
# self-contained, so they render even when the app bundle cannot load.
# ---------------------------------------------------------------------------
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ---------------------------------------------------------------------------
# Cloudflare origin lock — ALWAYS ON (requirement CR1).
#
# The site is only reachable when the request carries the shared secret header
# that Cloudflare injects (Rules -> Transform Rules -> Modify request header ->
# Set static: X-Origin-Secret). Requests that reach the origin directly are
# refused with 403.
#
# The tracked file only ever contains the placeholder below. The real value is
# injected at build time from the git-ignored private-config/cf-origin-secret.txt
# (or BRIG_CF_ORIGIN_SECRET).
#
# Deliberately NOT wrapped in <IfModule mod_rewrite.c>: if mod_rewrite were
# missing, a wrapped block would silently serve the origin unprotected
# (fail-open). Unwrapped, Apache errors instead (fail-closed). The deployment
# guide already requires mod_rewrite.
# ---------------------------------------------------------------------------
RewriteEngine On

# 1) Certificate validation must stay reachable — for EVERY host and at any
#    depth — with or without the Cloudflare header:
#      /.well-known/acme-challenge/...   Let's Encrypt / ACME via cPanel AutoSSL
#      /.well-known/pki-validation/...   HTTP file-based Domain Control Validation
#    cPanel writes these files itself and the CA validates them straight against
#    this host, bypassing Cloudflare. The tokens are public and single-use, so
#    exempting them does not weaken the lock; blocking them silently breaks
#    certificate renewal and the site eventually drops off HTTPS.
#    The pattern is unanchored so it also matches nested paths
#    (e.g. /brig/.well-known/acme-challenge/...).
RewriteCond %{REQUEST_URI} /\.well-known/
RewriteRule ^ - [L]

# 2) The branded error pages must render even when the lock denies a request,
#    otherwise Apache appends "Additionally, a 403 Forbidden error was
#    encountered while trying to use an ErrorDocument". They are static and
#    contain no application data.
RewriteCond %{REQUEST_URI} ^/(403|404|500)\.html$
RewriteRule ^ - [L]

# 3) Deny every request that does not carry the exact secret.
RewriteCond %{HTTP:X-Origin-Secret} !^__BRIG_CF_ORIGIN_SECRET__$
RewriteRule ^ - [F,L]

# 4) The application publishes exactly one real URL besides "/": the About view,
#    pushed with history.pushState. Serve index.html for it so a reload or a
#    bookmark works instead of dropping the visitor on the 404 page. Any other
#    unknown path still gets the branded 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about/?$ index.html [L]

<IfModule mod_headers.c>
  # A strict CSP can be tightened to match your final asset hosts.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'self'; frame-ancestors 'self'"
</IfModule>

# Block direct web access to server-side / private folders (PHP reads them
# from the filesystem instead).
RedirectMatch 404 ^/(database|data|scripts|tests|private-config)(/|$)

# Never serve dotfiles: this .htaccess carries the Cloudflare origin secret and
# .env-style files may carry credentials. Safe for certificate validation — the
# ACME/DCV response files under /.well-known/ do not start with a dot.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

